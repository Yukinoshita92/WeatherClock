# ============================================================
#  Weather Clock OTA · Git 属性
# ============================================================

# 文本文件：由 Git 自动识别，仓库内统一存 LF（检出时按平台策略还原）
* text=auto

# ---------- 二进制文件：禁止任何换行符转换 ----------
*.xbin   binary
*.bin    binary
*.hex    binary
*.axf    binary
*.elf    binary
*.o      binary
*.exe    binary
*.dll    binary
*.lib    binary
*.jpg    binary
*.jpeg   binary
*.png    binary
*.bmp    binary

# ---------- Keil 工程文件：保持原样，避免换行符被改写导致 uVision 解析异常 ----------
*.uvprojx  -text
*.uvoptx   -text
*.uvguix*  -text
*.sct      -text
*.scvd     -text

# 避免 GitHub 把汇编/C 统计成其它语言
*.s linguist-language=C
